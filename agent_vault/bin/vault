#!/bin/sh
# agent-vault CLI launcher: runs the recorded Python on the vault.py next to this folder.
# The installer writes the Python's path to the config; this never searches PATH, except for
# `doctor` alone: when the config is missing or its Python is gone, doctor runs on python3, then
# python, from PATH (after the usual line on stderr), so a broken install still gets its report.
config="${AGENT_VAULT_CONFIG:-$HOME/.claude/agent-vault.json}"
here=$(cd "$(dirname "$0")/.." && pwd)
if [ ! -f "$config" ]; then
  msg="agent-vault is not installed (no config at $config); run install.py"
else
  py=$(sed -n 's/^[[:space:]]*"python":[[:space:]]*"\(.*\)"[[:space:]]*,\{0,1\}[[:space:]]*$/\1/p' "$config" | head -n 1)
  if [ -n "$py" ] && [ -f "$py" ]; then
    exec "$py" "$here/vault.py" "$@"
  fi
  msg="agent-vault's Python is gone (${py:-not recorded in $config}); rerun install.py"
fi
echo "$msg" >&2
if [ "$1" = "doctor" ]; then
  for cand in python3 python; do
    if command -v "$cand" >/dev/null 2>&1; then
      exec "$cand" "$here/vault.py" "$@"
    fi
  done
fi
exit 1
